PORT=5000
NODE_ENV=development
# REQUIRED — persistent MongoDB (MongoDB Atlas). FlowBoard never falls back to an
# in-memory database; put a real connection string in backend/.env (never commit it).
# DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
# Auth — generate a long random string for production:
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Optional: imgbb API key for profile photo uploads (POST /api/uploads/avatar).
# Without it, avatar uploads return 503 "Uploads are disabled".
# IMGBB_KEY=paste-your-imgbb-api-key-here

# Optional: AI features (POST /api/ai/generate-tasks, POST /api/ai/summarize).
# Leave AI_PROVIDER=demo and AI_API_KEY empty for demo mode — deterministic,
# clearly-labeled responses so the product never breaks without a key.
# For real LLM output set AI_PROVIDER=gemini or =openai and add a key:
# AI_PROVIDER=demo
# AI_API_KEY=
# AI_MODEL=gemini-1.5-flash
